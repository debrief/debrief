<project name="org.mwc.debrief.lite" default="dist" basedir=".">
	<tstamp>
	      <format property="today_date" pattern="dd MMM yyyy HH:mm"  locale="en,UK" />
	</tstamp>
	<!-- Compiler settings. -->
	<property name="javacSource" value="1.7"/>
	<property name="javacTarget" value="1.7"/>
	<property name="build.compiler" value="extJavac"/>
	<condition property="dir_bootclasspath" value="${java.home}/../Classes">
		<and>
			<os family="mac"/>
			<available file="${java.home}/../Classes" type="dir"/>
		</and>
	</condition>
	<property name="dir_bootclasspath" value="${java.home}/lib"/>
	<path id="path_bootclasspath">
		<fileset dir="${dir_bootclasspath}">
			<include name="*.jar"/>
		</fileset>
	</path>
	<property name="bootclasspath" refid="path_bootclasspath"/>
	<condition property="bundleBootClasspath" value="${JavaSE-1.7}"	>
		<isset property="JavaSE-1.7"/>
	</condition>
	<property name="bundleBootClasspath" value="${bootclasspath}"/>
	<xmlproperty file="pom.xml"/>
		
	<target name="init">
		<condition property="pluginTemp" value="${buildTempFolder}/plugins"		>
			<isset property="buildTempFolder"/>
		</condition>
		<property name="svg-symbols.source.dir" value="../org.mwc.cmap.legacy/svg_symbols"/>
		<property name="svg-symbols.dest.dir" value="svg_symbols"/>
		<property name="pluginTemp" value="${basedir}"/>
		<property name="product.version" value="${project.version}"/>
		<condition property="build.result.folder" value="${pluginTemp}/org.mwc.debrief.lite_${product.version}"		>
			<isset property="buildTempFolder"/>
		</condition>
		<property name="build.result.folder" value="${basedir}"/>
		<property name="temp.folder" value="${basedir}/temp.folder"/>
		<property name="dist.dir" value="dist"/>
		<property name="dist.lib.dir" value="dist/lib"/>
	</target>
	<!-- the build date is written as a resource into the jar staging dir, so
	     the build does not modify tracked sources. BuildDate reads it at runtime. -->
	<target name="buildDate">
		<mkdir dir="${temp.folder}/debrief_lite.jar.bin/org/mwc/debrief/lite"/>
		<echo file="${temp.folder}/debrief_lite.jar.bin/org/mwc/debrief/lite/builddate.txt" message="${today_date}"/>
	</target>
	<target name="debrief_lite.jar" depends="quiet,init" unless="debrief_lite.jar" description="Create jar: org.mwc.debrief.lite debrief_lite.jar.">
		<delete dir="${temp.folder}/debrief_lite.jar.bin"/>
		<mkdir dir="${temp.folder}/debrief_lite.jar.bin"/>
		<path id="debrief_lite.jar.classpath">
			<pathelement location="../org.mwc.debrief.legacy/cmap_legacy.jar"/>
			<pathelement location="../org.mwc.debrief.legacy/debrief_legacy.jar"/>
			<pathelement location="../org.mwc.cmap.geotools/cmap_geotools.jar"/>
			<fileset dir="../org.mwc.cmap.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset><fileset dir="../org.mwc.cmap.legacy/libs" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.debrief.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset><fileset dir="../org.mwc.debrief.legacy/libs" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.cmap.jfreechart" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.cmap.geotools" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset>
			<fileset dir="." includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset>
		</path>
		<!-- compile the source code -->
		<javac release="21" destdir="${temp.folder}/debrief_lite.jar.bin" failonerror="true">
			<classpath refid="debrief_lite.jar.classpath" />
			<src path="src/"			/>
		</javac>
		<!-- Copy necessary resources -->
		<copy todir="${temp.folder}/debrief_lite.jar.bin" failonerror="true" overwrite="false">
			<fileset dir="src/test/java">
				<exclude name="**/*.java"/>
				<exclude name="**/package.htm*"/>
			</fileset>
			<fileset dir="src/main/java">
				<exclude name="**/*.java"/>
				<exclude name="**/package.htm*"/>
			</fileset>
			<fileset dir="src/main/java">
				<include name="images"/>
		 	</fileset>
		</copy>
		<antcall target="buildDate"/>
		<!-- update a copy of the hand-maintained manifest, not the tracked file itself -->
		<copy file="${basedir}/conf/manifest.txt" tofile="${temp.folder}/manifest.txt" overwrite="true"/>
		<manifest file="${temp.folder}/manifest.txt" mode="update">
			<attribute name="Implementation-Version" value="${product.version}"/>
		</manifest>
		<jar  manifest="${temp.folder}/manifest.txt" destfile="${temp.folder}/debrief_lite.jar" basedir="${temp.folder}/debrief_lite.jar.bin">
		</jar>
		<delete dir="${temp.folder}/debrief_lite.jar.bin"/>
	</target>
	
	<target name="testClasspath" depends="init">
		<path id="debrief_lite.test.classpath">
			<pathelement location="../org.mwc.debrief.legacy/cmap_legacy.jar"/>
			<pathelement location="../org.mwc.debrief.legacy/debrief_legacy.jar"/>
			<pathelement location="../org.mwc.cmap.geotools/cmap_geotools.jar"/>
			<fileset dir="../org.mwc.cmap.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset><fileset dir="../org.mwc.cmap.legacy/libs" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.debrief.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset><fileset dir="../org.mwc.debrief.legacy/libs" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.cmap.jfreechart" includes="*.jar"></fileset>
			<fileset dir="../org.mwc.cmap.geotools" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset>
			<fileset dir="." includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"></fileset>
			<fileset file="${temp.folder}/debrief_lite.jar"/>
		</path>
	</target>

	<!-- Headless tests: no display needed, so they run in every build (skipped only with
	     -DskipTests). java.awt.headless=true makes any accidental UI use fail loudly. -->
	<target name="headlessTests" depends="init,testClasspath" unless="skipTests">
		<property name="headless.report.dir" value="${temp.folder}/headless-reports"/>
		<mkdir dir="${headless.report.dir}"/>
		<junit dir="${basedir}" printsummary="yes" haltonfailure="no"
			failureproperty="lite.headless.failed" errorproperty="lite.headless.failed">
			<classpath refid="debrief_lite.test.classpath" />
			<formatter type="xml" />
			<formatter type="plain" />
			<sysproperty key="java.awt.headless" value="true"/>
			<sysproperty key="TEST_MODE" value="true"/>
			<batchtest fork="true" todir="${headless.report.dir}">
				<fileset dir="src/test/java" includes="**/headless/*Test.java"/>
			</batchtest>
		</junit>
		<fail if="lite.headless.failed" message="Debrief Lite headless tests failed: see ${headless.report.dir}"/>
	</target>

	<!-- skipped when the build is run with -DskipTests, which maven-antrun
	     passes through as an Ant property. The Ant junit task below is not
	     covered by surefire's own skipTests handling. -->
	<target name="unitTests" depends="init,testClasspath" if="liteUiTests" unless="skipTests">
		<mkdir dir="${temp.folder}/reports"/>
		<property name="report.dir" value="${temp.folder}/reports"/>
				<junit dir="${basedir}"
					printsummary="yes" haltonfailure="no" failureproperty="lite.tests.failed" errorproperty="lite.tests.failed">
					<classpath refid="debrief_lite.test.classpath" />
					<classpath location="src/test/java" />
					<classpath location="${env.ANT_HOME}/lib"> </classpath>
					<formatter type="xml" />
					<formatter type="plain" />
					<sysproperty key="TEST_MODE" value="true"/>
					<batchtest fork="true" todir="${report.dir}">
						

							<fileset dir="src/test/java">
								<include name="**/*Test*.java" />
								<exclude name="**/*Util*.java"/>
								<exclude name="**/*TestCase*.java"/>
								<exclude name="**/*AllTests.java"/>
								<exclude name="**/headless/**"/>
							</fileset>
						
						</batchtest>
				</junit>
				<!-- run every test class, then fail if any failed -->
				<fail if="lite.tests.failed" message="Debrief Lite UI tests failed: see ${report.dir}"/>
	</target>
	
	<target name="runTests" depends="init,debrief_lite.jar" description="run the tests independently">
		
		<antcall target="unitTests"></antcall>
	</target>


	<target name="build.jars" depends="init" description="Compile classes and build nested jars for the plug-in: org.mwc.debrief.lite.">
		<delete file="${compilation.problem.marker}" quiet="true"/>
		<available property="debrief_lite.jar" file="${build.result.folder}/debrief_lite.jar"/>
		<antcall target="debrief_lite.jar"/>
	</target>

	<target name="build.sources" depends="init">
		<available property="debrief_litesrc.zip" file="${build.result.folder}/debrief_litesrc.zip"/>
		<antcall target="debrief_litesrc.zip"/>
	</target>

	<target name="generate" depends="init,build.jars">
		<mkdir dir="${dist.dir}"/>
		<property name="debrief-lite-dist.dir" value="${dist.dir}/debrief-lite-jar"/>
		<property name="debrief-lite-lib.dir" value="${debrief-lite-dist.dir}/lib"/>
		<mkdir dir="${debrief-lite-dist.dir}"/>
		<mkdir dir="${debrief-lite-dist.dir}/lib"/>
		<mkdir dir="${debrief-lite-dist.dir}/${svg-symbols.dest.dir}"/>
		<copy todir="${debrief-lite-dist.dir}" failonerror="true" overwrite="false">
			<fileset dir="${temp.folder}">
				<include name="debrief_lite.jar"/>
			</fileset>
		</copy>
		<copy todir="${debrief-lite-lib.dir}" failonerror="true" overwrite="true">
			<fileset dir="../org.mwc.cmap.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"/><fileset dir="../org.mwc.cmap.legacy/libs" includes="*.jar"/>
			<fileset dir="../org.mwc.debrief.legacy" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"/><fileset dir="../org.mwc.debrief.legacy/libs" includes="*.jar"/>
			<fileset dir="../org.mwc.cmap.jfreechart" includes="*.jar"/>
			<fileset dir="../org.mwc.cmap.geotools" includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"/>
			<fileset dir="../org.mwc.debrief.legacy" includes="cmap_legacy.jar"/>
			<fileset dir="../org.mwc.cmap.geotools" includes="cmap_geotools.jar"/>
			<fileset dir="../org.mwc.debrief.legacy" includes="debrief_legacy.jar"/>
			<fileset dir="." includes="*.jar" excludes="cmap_legacy.jar,debrief_legacy.jar,cmap_geotools.jar,debrief_lite.jar"/>
		</copy>
		<copy todir="${debrief-lite-dist.dir}/${svg-symbols.dest.dir}"><fileset dir="${svg-symbols.source.dir}" includes="**/*"></fileset></copy>
		<copy todir="${debrief-lite-dist.dir}" file="src/main/java/icons/d_lite.png" failonerror="true" overwrite="false"/>
		<!-- Scaled splash images for HiDPI displays (Windows UI zoom). Java takes the image
		     from the jar, but only after finding a file of that name relative to the working
		     directory, so they must also sit beside the jar. Without them the splash is shown
		     pixel-for-pixel, which is tiny at 200% zoom. They are splash.gif upscaled; Windows
		     wants splash@NNNpct.gif for fractional scales and splash@Nx.gif for whole ones. -->
		<copy todir="${debrief-lite-dist.dir}/images" failonerror="true" overwrite="true">
			<fileset dir="src/main/java/images" includes="splash@*.gif"/>
		</copy>
		<zip destfile="${dist.dir}/debrief-lite-${product.version}.zip">
			<fileset dir="." includes="data/**/*"/>
			<fileset dir="." includes="*.pdf"/>
			<fileset dir="${debrief-lite-dist.dir}" includes="**/*"/>
		</zip>
	</target>
	<target name="quiet">
<!--
				<script language="javascript">
				        var logger = project.getBuildListeners( ).firstElement( );
				        logger.setMessageOutputLevel( 0 );
				    </script>
-->
	</target>

	<target name="clean" depends="quiet,init" description="Clean the plug-in: org.mwc.debrief.lite of all the zips, jars and logs created.">
		<delete file="${build.result.folder}/debrief_lite.jar"/>
		<delete file="debrief_lite.jar"/>
		<delete file="${plugin.destination}/org.mwc.debrief.lite_*.jar"/>
		<delete file="${plugin.destination}/org.mwc.debrief.lite_*.zip"/>
		<delete dir="${temp.folder}"/>
		<delete file="${basedir}/*.jar"/>
		<delete dir="${dist.dir}"/>
	</target>
	<target name="makeonejar" depends="generate">
			<move file="${temp.folder}/debrief_lite.jar" tofile="${dist.dir}/main.jar"/>
			<taskdef name="one-jar"
				         classname="com.simontuffs.onejar.ant.OneJarTask"
				         classpath="../org.mwc.debrief.legacy/conf/one-jar-ant-task-0.97.jar"
				         onerror="report"/>
			<one-jar destfile="${dist.dir}/DebriefLite-${product.version}.jar">
				<main jar="${dist.dir}/main.jar">
				</main>
				<lib>
					<fileset dir="${dist.dir}/lib/" includes="**/*.jar" />
				</lib>
			</one-jar>
			<delete file="${dist.dir}/main.jar"/>
			<delete dir="${dist.dir}/lib"/>
		</target>
	<target name="dist" depends="clean">
		<ant antfile="build.xml" dir="../org.mwc.debrief.legacy" target="debrief_legacy.jar" inheritAll="false"/>
		<ant antfile="build.xml" dir="../org.mwc.cmap.geotools" target="geotools_jar" inheritAll="false"/>
		<antcall target="generate"/>
	</target>
	
	<!-- Used by the Maven build: produces dist/debrief-lite-<version>.zip. The reactor has
	     already built cmap_legacy.jar and debrief_legacy.jar; cmap_geotools.jar is jarred
	     from geotools' compiled classes. (makeonejar's single jar does not run: GeoTools'
	     LocaleUtils cannot read its resources through One-JAR's class loader.) -->
	<target name="ci" depends="clean">
		<copy file="../org.mwc.cmap.legacy/cmap_legacy.jar" todir="../org.mwc.debrief.legacy" overwrite="true"/>
		<jar destfile="../org.mwc.cmap.geotools/cmap_geotools.jar" basedir="../org.mwc.cmap.geotools/target/classes"/>
		<antcall target="generate"/>
		<antcall target="headlessTests"/>
		<antcall target="unitTests"/>
	</target>

	<target name="all" depends="dist,unitTests">
	</target>
</project>