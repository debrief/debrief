// Source for eclipse-latest.target, in the CBI target platform DSL
// (https://github.com/eclipse-cbi/targetplatform-dsl). Edit both together:
// the build reads only the .target file.
target "eclipse-latest"

with source requirements

location "https://download.eclipse.org/releases/2026-09/202609091000/" {
	// Dali (JPA tools) bundles
	org.eclipse.jpt.common.branding
	org.eclipse.jpt.common.core
	org.eclipse.jpt.common.eclipselink.branding
	org.eclipse.jpt.common.eclipselink.core
	org.eclipse.jpt.common.ui
