	org.eclipse.jpt.jpa.eclipselink.ui
	org.eclipse.jpt.jpa.gen
	org.eclipse.jpt.jpa.ui
	org.eclipse.jpt.jpadiagrameditor.branding
	org.eclipse.jpt.jpadiagrameditor.doc.user
	org.eclipse.jpt.jpadiagrameditor.ui
	org.eclipse.wtp.jee.capabilities

	// XML editor and JDT
	org.eclipse.wst.xml_ui.feature.feature.group
	org.eclipse.jdt.feature.group

	// Eclipse platform, RCP, PDE, EMF, GEF, ECF and p2
	org.eclipse.equinox.executable.feature.group
	org.eclipse.pde.feature.group
	org.eclipse.ecf.core.feature.feature.group
	org.eclipse.emf.common.feature.group
	org.eclipse.emf.common.ui.feature.group
	org.eclipse.emf.ecore.edit.feature.group
	org.eclipse.emf.ecore.feature.group
	org.eclipse.emf.edit.feature.group
