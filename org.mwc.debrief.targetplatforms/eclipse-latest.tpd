	org.eclipse.rcp.feature.group
	org.eclipse.xsd.edit.feature.group
	org.eclipse.xsd.feature.group
	org.eclipse.ui.views.log

	// Libraries
	com.google.guava
	com.google.gson
	com.google.protobuf
	org.objectweb.asm
	javax.activation

	// Web Tools Platform features
	org.eclipse.jpt.common.eclipselink.feature.feature.group
	org.eclipse.jpt.common.feature.feature.group
	org.eclipse.jpt.jaxb.eclipselink.feature.feature.group
	org.eclipse.jpt.jaxb.feature.feature.group
	org.eclipse.jpt.jpa.eclipselink.feature.feature.group
