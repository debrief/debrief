<!--
  Third-party jars from Maven Central, copied into the plugins that use them.

  Each jar is a <dependency> below, so Dependabot can raise version bumps.
  The copy step gives each one a fixed, version-free file name in its
  plugin folder (for example org.mwc.debrief.legacy/pdfbox.jar), so the
  plugin's MANIFEST.MF, build.properties and .classpath don't change when
  a version does. The copied jars are git-ignored.

  This module is first in the reactor, so a full build always fetches them.
  To build one plugin on its own, or after a fresh clone for the Eclipse
  IDE, run:
      mvn -pl org.mwc.debrief.thirdparty generate-resources
  See docs/dependencies/maven-jars.md.
 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.mwc.debrief</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>org.mwc.debrief.thirdparty</artifactId>
  <packaging>pom</packaging>

  <!-- The jars, one per entry. Only the jar itself is copied: the
       exclusions keep Maven from fetching transitive dependencies, which
       the plugins don't take this way. -->
  <dependencies>
    <!-- org.mwc.debrief.legacy -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>2.0.37</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>fontbox</artifactId>
      <version>2.0.37</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>commons-cli</groupId>
      <artifactId>commons-cli</artifactId>
      <version>1.4</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.23.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.xmlunit</groupId>
      <artifactId>xmlunit-core</artifactId>
      <version>2.14.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.january</groupId>
      <artifactId>org.eclipse.january</artifactId>
      <version>2.0.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- org.mwc.cmap.legacy -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>SparseBitSet</artifactId>
      <version>1.3</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.20.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-collections4</artifactId>
      <version>4.5.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.22.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.21.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>3.6.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>com.github.virtuald</groupId>
      <artifactId>curvesapi</artifactId>
      <version>1.08</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.22</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>2.22.4</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.4</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>joda-time</groupId>
      <artifactId>joda-time</artifactId>
      <version>2.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.26.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.5.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml-lite</artifactId>
      <version>5.5.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-scratchpad</artifactId>
      <version>5.5.1</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlbeans</groupId>
      <artifactId>xmlbeans</artifactId>
      <version>5.3.0</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest-core</artifactId>
      <version>1.3</version>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>org.mwc.debrief.legacy</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.basedir}/../org.mwc.debrief.legacy</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <!-- versions come from <dependencies> above -->
              <artifactItems>
                <artifactItem><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><destFileName>pdfbox.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.pdfbox</groupId><artifactId>fontbox</artifactId><destFileName>fontbox.jar</destFileName></artifactItem>
                <artifactItem><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><destFileName>commons-logging.jar</destFileName></artifactItem>
                <artifactItem><groupId>commons-cli</groupId><artifactId>commons-cli</artifactId><destFileName>commons-cli.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.jsoup</groupId><artifactId>jsoup</artifactId><destFileName>jsoup.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.xmlunit</groupId><artifactId>xmlunit-core</artifactId><destFileName>xmlunit-core.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.eclipse.january</groupId><artifactId>org.eclipse.january</artifactId><destFileName>org.eclipse.january.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><destFileName>slf4j-api.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><destFileName>slf4j-simple.jar</destFileName></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>org.mwc.cmap.legacy</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.basedir}/../org.mwc.cmap.legacy</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <artifactItems>
                <artifactItem><groupId>com.zaxxer</groupId><artifactId>SparseBitSet</artifactId><destFileName>SparseBitSet.jar</destFileName></artifactItem>
                <artifactItem><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><destFileName>commons-codec.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.commons</groupId><artifactId>commons-collections4</artifactId><destFileName>commons-collections4.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><destFileName>commons-compress.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.commons</groupId><artifactId>commons-csv</artifactId><destFileName>commons-csv.jar</destFileName></artifactItem>
                <artifactItem><groupId>commons-io</groupId><artifactId>commons-io</artifactId><destFileName>commons-io.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><destFileName>commons-lang3.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.commons</groupId><artifactId>commons-math3</artifactId><destFileName>commons-math3.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.github.virtuald</groupId><artifactId>curvesapi</artifactId><destFileName>curvesapi.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><destFileName>jackson-annotations.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><destFileName>jackson-core.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><destFileName>jackson-databind.jar</destFileName></artifactItem>
                <artifactItem><groupId>joda-time</groupId><artifactId>joda-time</artifactId><destFileName>joda-time.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><destFileName>log4j-api.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.poi</groupId><artifactId>poi</artifactId><destFileName>poi.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><destFileName>poi-ooxml.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.poi</groupId><artifactId>poi-ooxml-lite</artifactId><destFileName>poi-ooxml-lite.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.poi</groupId><artifactId>poi-scratchpad</artifactId><destFileName>poi-scratchpad.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.xmlbeans</groupId><artifactId>xmlbeans</artifactId><destFileName>xmlbeans.jar</destFileName></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>org.mwc.cmap.legacy-libs</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.basedir}/../org.mwc.cmap.legacy/libs</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <artifactItems>
                <artifactItem><groupId>junit</groupId><artifactId>junit</artifactId><destFileName>junit.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.hamcrest</groupId><artifactId>hamcrest-core</artifactId><destFileName>hamcrest-core.jar</destFileName></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
